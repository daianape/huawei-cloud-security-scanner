# ============================================================
# Huawei Cloud Security Scanner - Configuracion
# ============================================================
#
# AUTENTICACION (variables de entorno, NO van en este archivo):
#
#   Windows CMD:
#     set HWCLOUD_AK=tu_access_key
#     set HWCLOUD_SK=tu_secret_key
#
#   Windows PowerShell:
#     $env:HWCLOUD_AK="tu_access_key"
#     $env:HWCLOUD_SK="tu_secret_key"
#
#   Linux/Mac:
#     export HWCLOUD_AK=tu_access_key
#     export HWCLOUD_SK=tu_secret_key
#
# ============================================================

# Modo de escaneo: "single" o "multi"
mode: "single"

# Domain ID (Account ID)
# Obtener desde: Huawei Console > My Credentials > Account ID
domain_id: ""

# === REGIONES ===
# Completar el project_id de las regiones que quieras escanear.
# Las regiones con project_id vacio seran ignoradas al usar --regions all.
# La PRIMERA region con project_id se usa como region principal por defecto.
#
# Obtener Project IDs desde: Huawei Console > My Credentials > API Credentials
#
# Para agregar una nueva region:
#   1. Ir a Huawei Console > My Credentials > API Credentials
#   2. Copiar el Project ID de la nueva region
#   3. Agregar una entrada al listado con el formato:
#        - region: "codigo-de-region"
#          project_id: "el-project-id"
#
regions:
  # Latin America
  - region: "la-south-2"
    project_id: ""          # LA-Santiago (Chile)
  - region: "la-north-2"
    project_id: ""          # LA-Mexico City

  # South America
  - region: "sa-brazil-1"
    project_id: ""          # Sao Paulo (Brasil)
  - region: "sa-argentina-1"
    project_id: ""          # Buenos Aires (Argentina)

  # Asia Pacific
  - region: "ap-southeast-1"
    project_id: ""          # Hong Kong
  - region: "ap-southeast-2"
    project_id: ""          # Bangkok (Thailand)
  - region: "ap-southeast-3"
    project_id: ""          # Singapore
  - region: "ap-southeast-4"
    project_id: ""          # Jakarta (Indonesia)
  - region: "my-kualalumpur-1"
    project_id: ""          # Kuala Lumpur (Malaysia)

  # Europe
  - region: "eu-west-0"
    project_id: ""          # Paris (France)
  - region: "eu-west-101"
    project_id: ""          # Dublin (Ireland)

  # Middle East
  - region: "tr-west-1"
    project_id: ""          # Istanbul (Turkey)
  - region: "me-east-1"
    project_id: ""          # Riyadh (Saudi Arabia)

  # Africa
  - region: "af-south-1"
    project_id: ""          # Johannesburg (South Africa)

  # China (requiere cuenta China separada, normalmente no aplica)
  # - region: "cn-north-4"
  #   project_id: ""        # Beijing
  # - region: "cn-east-3"
  #   project_id: ""        # Shanghai
  # - region: "cn-south-1"
  #   project_id: ""        # Guangzhou

# === SCANNERS ===
# Habilitar/deshabilitar scanners individuales
scanners:
  # Existentes
  iam: true
  vpc: true
  ecs: true
  obs: true
  cts: true
  elb: true
  # Nuevos (alta prioridad)
  rds: true
  dcs: true
  nat: true
  eip: true
  waf: true
  cfw: true
  evs: true
  kms: true
  cce: true
  # Nuevos (media prioridad)
  cbr: true
  vpn: true
  dns: true
  sfs: true
  functiongraph: true
  ces: true
  lts: true
  smn: true
  # Adicionales
  bms: true
  ims: true
  # Servicios globales (requieren habilitacion previa en la cuenta)
  identity-center: false
  config: false
  tms: false

# === OUTPUT ===
output:
  directory: "./output"
  formats:
    - html
    - json
    - csv
